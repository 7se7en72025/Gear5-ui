{
  "name": "bharat-ui",
  "version": "0.1.0",
  "description": "Form primitives for Indian fintech — UPI, PAN, Aadhaar, IFSC and GST inputs for React.",
  "keywords": ["upi", "vpa", "india", "fintech", "kyc", "react", "shadcn", "npci"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lucide-react": "^1.28.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "^0.11.0",
    "typescript": "^5.7.0"
  }
}

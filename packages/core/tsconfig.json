{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // tsup's dts worker runs tsc without a buildinfo path, which rejects
    // --incremental; the `next` plugin from the base config is docs-only.
    "incremental": false,
    "plugins": [],
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
